# Copy to backend/.env and fill values on the server. Do not commit real secrets.

DEBUG=false
SEED_DEFAULT_USERS=false

SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=

# Active provider comes from the database when set, otherwise from PRIMARY_LLM.
ASSIGNEE_MAX_PATENTS_WHEN_SINGLE=1

PRIMARY_LLM=gemini
FALLBACK_LLM=openai
ENABLE_FALLBACK=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
SERPER_API_KEY=

# Implemented, not selectable in Settings, and not used as the default fallback.
GROQ_API_KEY=
GROK_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

LOG_LEVEL=INFO
LOG_DIR=logs
